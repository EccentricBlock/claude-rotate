# Local secrets and runtime state — never commit
config.json
config.json.tmp
tokens/
*.token
state.json
logs/
__pycache__/
*.pyc
.DS_Store
.omc/
usage_history.json
device_usage.json

# Sandbox placeholders (/dev/null mounts): never stage. Exact names only.
# .mcp.json and the .claude/ names recur under every subdirectory a session
# works in, so they match at any depth. Never list .claude/ wholesale.
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.idea
/.vscode
**/.mcp.json
**/.claude/agents
**/.claude/commands
**/.claude/hooks
**/.claude/launch.json
**/.claude/loop.md
**/.claude/output-styles
**/.claude/routines
**/.claude/scheduled_tasks.json
**/.claude/settings.json
**/.claude/settings.local.json
**/.claude/skills
**/.claude/workflows
# Real at the root in this project: re-include each path it tracks.
!/.claude/hooks
!/.claude/settings.json
